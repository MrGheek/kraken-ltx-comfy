# syntax=docker/dockerfile:1.7
#
# LTX-2.5 ComfyUI worker image — kaniko/buildah variant.
#
# Uses a small CUDA base + a pinned ComfyUI commit instead of the large
# vastai/comfy image. Pass HF_TOKEN as a build arg (masked in logs by kaniko).
#
# Build requires linux/amd64 and >= 80 GB free disk (~45-50 GB final image).
FROM nvidia/cuda:12.8.1-runtime-ubuntu22.04

ARG HF_TOKEN
ARG COMFY_REF=1332fabfcc507aa7c548cd5152071ed494c207e8

ENV DEBIAN_FRONTEND=noninteractive \
    HF_HUB_ENABLE_HF_TRANSFER=1 \
    COMFY_DIR=/opt/ComfyUI \
    COMFY_PORT=9188 \
    WORKER_PORT=8188

RUN apt-get update -qq && \
    apt-get install -y -qq --no-install-recommends \
        git python3 python3-pip python3-venv \
        ffmpeg libgl1 libglib2.0-0 curl ca-certificates && \
    rm -rf /var/lib/apt/lists/*

# CUDA PyTorch first; ComfyUI requirements list bare `torch`, so pip keeps it.
RUN python3 -m pip install --no-cache-dir --upgrade pip && \
    python3 -m pip install --no-cache-dir \
        torch torchvision torchaudio \
        --index-url https://download.pytorch.org/whl/cu128

RUN git clone https://github.com/comfyanonymous/ComfyUI.git /opt/ComfyUI && \
    cd /opt/ComfyUI && \
    git checkout "$COMFY_REF" && \
    python3 -m pip install --no-cache-dir -r requirements.txt

RUN ln -sfn /opt/ComfyUI /comfyui && \
    python3 -m pip install --no-cache-dir "huggingface_hub[cli]" hf_transfer

# ETN_LoadImageBase64 (I2V conditioning) comes from ComfyUI_essentials.
RUN git clone --depth 1 https://github.com/cubiq/ComfyUI_essentials.git \
      /opt/ComfyUI/custom_nodes/ComfyUI_essentials && \
    (python3 -m pip install --no-cache-dir \
      -r /opt/ComfyUI/custom_nodes/ComfyUI_essentials/requirements.txt 2>&1 | tail -5 || true)

# LTX-2.5 ComfyUI int8 pack. Each component is its own layer.
RUN mkdir -p /comfyui/models/diffusion_models && \
    HF_TOKEN="$HF_TOKEN" \
    python3 -m huggingface_hub.commands.huggingface_cli download \
      Lightricks/LTX-2.5 \
      --local-dir /comfyui/models \
      --include "diffusion_models/ltx-2.5-22b-distilled-transformer-comfy-int8-convrot.safetensors"

RUN mkdir -p /comfyui/models/text_encoders && \
    HF_TOKEN="$HF_TOKEN" \
    python3 -m huggingface_hub.commands.huggingface_cli download \
      Lightricks/LTX-2.5 \
      --local-dir /comfyui/models \
      --include "text_encoders/gemma4-12b-with-proj-ltx-2.5-comfy-int8-convrot.safetensors"

RUN mkdir -p /comfyui/models/vae && \
    HF_TOKEN="$HF_TOKEN" \
    python3 -m huggingface_hub.commands.huggingface_cli download \
      Lightricks/LTX-2.5 \
      --local-dir /comfyui/models \
      --include "vae/ltx-2.5-video-vae-bf16.safetensors" \
      --include "vae/ltx-2.5-audio-vae-bf16.safetensors"

RUN mkdir -p /comfyui/models/latent_upscale_models /comfyui/models/model_patches && \
    HF_TOKEN="$HF_TOKEN" \
    python3 -m huggingface_hub.commands.huggingface_cli download \
      Lightricks/LTX-2.5 \
      --local-dir /comfyui/models \
      --include "latent_upscale_models/ltx-2.5-latent-spatial-upscaler-x2-bf16-1.0.safetensors" && \
    HF_TOKEN="$HF_TOKEN" \
    python3 -m huggingface_hub.commands.huggingface_cli download \
      Lightricks/LTX-2.5 \
      --local-dir /comfyui/models \
      --include "model_patches/ltx-2.5-duration-head-bf16.safetensors"

RUN mkdir -p /comfyui/models/loras

COPY proxy.py /proxy.py
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 8188

HEALTHCHECK --interval=30s --timeout=10s --start-period=600s --retries=3 \
  CMD curl -fsS http://127.0.0.1:8188/system_stats >/dev/null || exit 1

CMD ["/entrypoint.sh"]
